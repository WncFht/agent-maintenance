{
  "name": "agent-maintenance",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "check": "python3 scripts/run_checks.py --config scripts/checks.json --mode ci"
  },
  "overrides": {
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "git-format-staged": "4.0.2",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.6"
  }
}
