{
  "name": "agent-maintenance",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{md,yaml,yml,json,jsonc}\"",
    "format:check": "prettier --check \"**/*.{md,yaml,yml,json,jsonc}\"",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "check": "python3 scripts/run_checks.py --config scripts/checks.json --mode ci",
    "test:preview": "node --test assets/.crossnote/tests/*.test.cjs",
    "build:preview": "node assets/.crossnote/scripts/build.cjs"
  },
  "overrides": {
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "crossnote": "0.9.42",
    "git-format-staged": "4.0.2",
    "less": "4.4.2",
    "markdownlint-cli2": "0.23.3",
    "mermaid11": "npm:mermaid@11.15.0",
    "mermaid12": "npm:mermaid@12.2.0",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7",
    "prettier": "3.9.6",
    "quickjs-emscripten": "0.32.0"
  }
}
